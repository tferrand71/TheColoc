# Copier ce fichier en .env sur le VPS et remplir les valeurs réelles.
# Ne jamais committer .env

DATABASE_URL=postgresql://coloc:<PASSWORD>@postgres:5432/coloc
AUTH_SECRET=<générer avec : openssl rand -base64 32>
NEXTAUTH_URL=https://coloc.ton-domaine.fr
DOMAIN=coloc.ton-domaine.fr
VAPID_PUBLIC_KEY=<générer avec : node -e "const wp=require('web-push');const k=wp.generateVAPIDKeys();console.log(k.publicKey)">
VAPID_PRIVATE_KEY=<clé privée correspondante>
VAPID_EMAIL=mailto:tobiasferrand6@gmail.com
CRON_SECRET=<générer avec : openssl rand -hex 32>
